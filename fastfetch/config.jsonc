 {
    "logo": { /* Logo configuration */
      "source": "/home/poleaxe/Downloads/jasontodd.png",
  
      "padding": {
       "right": 1
      }
    },
   "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[37m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "#db194f"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "#db194f"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "keyColor": "#db194f"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "#db194f"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "#db194f"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "#db194f"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "#db194f"
    },
    {
      "type": "custom",
      "format": "\u001b[37m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[37m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "keyColor": "#db194f",
      "text": "version=$(omarchy-version); echo \"Omarchy $version\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "#db194f",
      "text": "branch=$(omarchy-version-branch); echo \"$branch\""
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "keyColor": "#db194f",
      "text": "channel=$(omarchy-version-channel); echo \"$channel\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#db194f"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "#db194f"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "#db194f"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "#db194f"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#db194f"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#db194f"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "#db194f",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "#db194f"
    },
    {
      "type": "custom",
      "format": "\u001b[37m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[37m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "#db194f",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "#db194f"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "#db194f",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[37m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
} 
